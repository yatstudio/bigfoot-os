# Bigfoot for btop: phosphor text on deep space, every graph drawn as the bigfoot beam —
# deep teal at the base, signal mint at the peaks.
# Same colours as extras/cliamp/bigfoot.toml.
theme[main_bg]=""
theme[main_fg]="#d8e4f0"
theme[title]="#ffffff"
theme[hi_fg]="#3ce8b5"
